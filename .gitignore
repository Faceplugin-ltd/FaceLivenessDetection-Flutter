# Face-LivenessDetection-Flutter — plugin + example
# (plugin root = publishable package; example/ = demo app)

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
*.swp
*.swo
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

*.iml
*.ipr
*.iws
.idea/
.vscode/
*.classpath
*.project
*.settings/

# ---------------------------------------------------------------------------
# Dart / Flutter (plugin + example)
# ---------------------------------------------------------------------------
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/
**/doc/api/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/coverage/
**/.symlinks/
.widget_preview/

# Plugin packages should not commit pubspec.lock (Dart library convention).
# Keep example/pubspec.lock for reproducible demo builds.
/pubspec.lock

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
**/local.properties
**/.gradle/
**/captures/
**/.cxx/
**/*.apk
**/*.aab
**/gradle-wrapper.jar
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.kt

# Signing — never commit secrets
**/key.properties
**/*.keystore
**/*.jks
!**/debug.keystore

# ---------------------------------------------------------------------------
# iOS / Xcode / CocoaPods
# Machine-local Flutter outputs — committing these embeds absolute paths
# (FLUTTER_ROOT / FLUTTER_APPLICATION_PATH) and breaks clean clones.
# ---------------------------------------------------------------------------
**/Pods/
**/DerivedData/
**/*.xcuserstate
**/xcuserdata/
**/*.mode1v3
**/*.mode2v3
**/*.pbxuser
**/*.perspectivev3
!**/*.default.mode1v3
!**/*.default.mode2v3
!**/*.default.pbxuser
!**/*.default.perspectivev3
**/*sync/
.sconsign.dblite
**/*.ipa
**/*.dSYM
**/*.dSYM.zip

example/ios/.symlinks/
example/ios/Flutter/Flutter.podspec
example/ios/Flutter/Generated.xcconfig
example/ios/Flutter/flutter_export_environment.sh
example/ios/Flutter/ephemeral/
example/ios/Flutter/App.framework
example/ios/Flutter/Flutter.framework
example/ios/Flutter/app.flx
example/ios/Flutter/app.zip
example/ios/Flutter/flutter_assets/
example/ios/Flutter/.last_build_id
example/ios/ServiceDefinitions.json
example/ios/Runner/GeneratedPluginRegistrant.*

# ---------------------------------------------------------------------------
# FacePlugin native runtimes (fetched by run_*.py / Releases)
# ---------------------------------------------------------------------------
*.aar
example/android/libfacesdk/**/*.aar
example/android/libfacesdk/**/*.so
android/libs/**/*.aar
ios/Frameworks/**/*.framework
ios/Frameworks/**/*.xcframework
ios/Frameworks/**/*.framework/**
ios/Frameworks/**/*.xcframework/**
!ios/Frameworks/README.md
!example/android/libfacesdk/README.md

